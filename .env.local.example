# ─────────────────────────────────────────────────────────────────────────────
# .env.local — Local development secrets (git-ignored)
# ─────────────────────────────────────────────────────────────────────────────
# This file is loaded by BOTH the Node.js portal (via dotenv) and Python
# scripts (via scripts/config.py). It is git-ignored and never committed.
#
# SECURITY PRECEDENCE (most secure → least):
#   1. Azure Key Vault  — production, secrets loaded at runtime via Managed Identity
#   2. .env.local       — local dev, never committed, overrides portal/.env
#   3. portal/.env      — portal-specific config, git-ignored
#
# To set up:
#   1. Copy this file to .env.local (remove the .example suffix)
#   2. Fill in your values
#   3. Both Node.js and Python scripts will pick them up automatically
# ─────────────────────────────────────────────────────────────────────────────

# Azure / Entra ID
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# Key Vault (recommended for production — leave empty for local dev)
AZURE_KEYVAULT_URL=

# Lab API keys
# (No external API keys are required by the current labs.)

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Power Platform (uses delegated auth — no secrets needed here)
# Authentication happens via device code flow at runtime.

# MCP Server
MCP_SERVER_URL=

# ── Lab builder (tools/lab-builder + the portal's "Build a Lab" tab) ─────────
# The lab builder always grounds content against the public Microsoft Learn MCP
# server, which needs no credentials. Everything below is optional and only adds
# scenario-specific narrative on top of that grounded content.
#
# Provider auto-detection order: Azure OpenAI -> GitHub Models -> deterministic.
# Set LAB_BUILDER_LLM=off to force deterministic composition.

# Option 1 — Azure OpenAI (all three are required together)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Option 2 — GitHub Models (a GITHUB_TOKEN with models access is enough)
GITHUB_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Overrides
LAB_BUILDER_LLM=
LEARN_MCP_URL=https://learn.microsoft.com/api/mcp
LEARN_MCP_TIMEOUT_MS=30000
