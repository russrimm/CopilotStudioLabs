{
  "name": "copilot-studio-lab-screenshot-capture",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive Playwright capture tool for the Copilot Studio Labs screenshots.",
  "type": "module",
  "scripts": {
    "capture": "node capture.js",
    "list": "node capture.js --list",
    "capture:features": "node capture.js --features",
    "list:features": "node capture.js --features --list",
    "verify:features": "node verify-shots.js --lab=feature-tour --missing",
    "verify": "node verify-shots.js"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  }
}
