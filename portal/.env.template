# Local listener. Containers override HOST to 0.0.0.0.
HOST=127.0.0.1
PORT=3005

# Local development only. Never disable authentication on a deployed listener.
PORTAL_AUTH_DISABLED=false
PORTAL_API_AUDIENCE=
PORTAL_ALLOWED_USERS=
PORTAL_ALLOWED_GROUPS=
PORTAL_BASE_URL=

# Microsoft Entra ID and Azure
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_KEYVAULT_URL=
AZURE_WEBAPP_NAME=
AZURE_RESOURCE_GROUP=
AZURE_ACR_NAME=
AZURE_ACR_IMAGE=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
EMAIL_RECIPIENT_ALLOWLIST=
EMAIL_RATE_WINDOW_MS=3600000
EMAIL_RATE_MAX=10

# Power Platform delegated sign-in
POWER_PLATFORM_ENV=
PP_CLIENT_ID=
PP_TENANT_ID=

# Optional integrations and feature flags
MCP_SERVER_URL=
LEARN_MCP_URL=https://learn.microsoft.com/api/mcp
LEARN_MCP_TIMEOUT_MS=30000
LAB_BUILDER_LLM_TIMEOUT_MS=60000
LAB_BUILDER_CONCURRENCY=4
LAB_BUILDER_MAX_ACTIVE=2
# Dynamic topic list from Microsoft Learn (see docs/lab-builder.md)
# Set to true to never contact Microsoft Learn for topics; the committed snapshot is used.
LAB_BUILDER_TOPICS_DISABLED=false
# Run a scheduled refresh while the server is up (off by default); interval and cache lifetime are in milliseconds.
LAB_BUILDER_TOPICS_AUTO_REFRESH=false
LAB_BUILDER_TOPICS_REFRESH_MS=86400000
LAB_BUILDER_TOPICS_TTL_MS=86400000
# Where the runtime cache is written (defaults to portal/data/lab-builder/topics-cache.json, never committed).
LAB_BUILDER_TOPICS_CACHE=
# Budgets and protections for one refresh.
LAB_BUILDER_TOPICS_MAX_CALLS=500
LAB_BUILDER_TOPICS_MAX_PAGES=250
LAB_BUILDER_TOPICS_DEADLINE_MS=240000
LAB_BUILDER_TOPICS_CALL_TIMEOUT_MS=20000
LAB_BUILDER_TOPICS_MIN_REFRESH_MS=60000
LAB_BUILDER_TOPICS_BREAKER_FAILURES=3
LAB_BUILDER_TOPICS_BREAKER_COOLDOWN_MS=900000
LAB_BUILDER_TOPICS_RATE_MAX=6
LAB_BUILDER_TOPICS_RATE_WINDOW_MS=3600000
LAB_BUILDER_TOPICS_UPDATED_DAYS=30
ENABLE_GRAPH_EMAIL=false
ENABLE_AZURE_DEPLOY=false
