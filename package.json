{
  "name": "copilot-studio-labs",
  "version": "1.0.0",
  "private": true,
  "description": "Hands-on labs for building AI-powered agents with Microsoft Copilot Studio — customizable template.",
  "type": "module",
  "scripts": {
    "setup": "node setup.js",
    "setup:dry-run": "node setup.js --dry-run",
    "build-lab": "node tools/lab-builder/build.mjs",
    "build-lab:list": "node tools/lab-builder/build.mjs --list",
    "refresh-topics": "node tools/lab-builder/refresh-topics.mjs",
    "capture": "cd tools/screenshot-capture && npm run capture",
    "feature-tour:build": "node tools/feature-tour/build.mjs",
    "feature-tour:check": "node tools/feature-tour/build.mjs --check",
    "feature-tour:serve": "node tools/feature-tour/serve.mjs",
    "feature-tour:test": "node --test \"tools/feature-tour/test/*.test.mjs\"",
    "feature-tour:capture": "cd tools/screenshot-capture && npm run capture:features",
    "feature-tour:verify": "node tools/screenshot-capture/verify-shots.js --lab=feature-tour --missing",
    "verify:appreg": "node scripts/verify-app-reg.js"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
